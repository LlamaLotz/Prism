{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prism",
  "version": "1.0.0",
  "identifier": "com.prism.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Prism",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
"plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4ODFCRjM3QjRFNDU4N0IKUldSN1dPUzBONytCR0JJYnB6KzdkQS94VXByYVVaL0tqNlZLcU5hdlQ1ZGhZcU1lcVBJTkMvVTEK",
      "endpoints": [
        "[https://github.com/LlamaLotz/Prism/releases/latest/download/latest.json](https://github.com/LlamaLotz/Prism/releases/latest/download/latest.json)"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "msi", "dmg"],
    "resources": [
      "../Extractor Final"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "uninstallerHeaderImage": "windows/installer-header.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "windows/dmg-background.png"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
