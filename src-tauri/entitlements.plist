<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: required for Apple notarization -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Required by WebKit (WkWebView / JavaScriptCore) for JIT compilation -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Allow loading of bundled dynamic libraries (.dylib) like ONNX Runtime -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Outbound network access (API calls, auto-updater, embedding model downloads) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- User-selected file read/write (vault import, notes, attachments) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>